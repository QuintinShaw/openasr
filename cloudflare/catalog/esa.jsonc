  "name": "openasr-catalog",
  "description": "catalog.bug.im — signed OpenASR catalog replica (byte-identical to catalog.openasr.org)",
  "entry": "./dist/esa/index.js",
  "codeVersions": [],
  "dev": {
    "port": 18070,
    "localUpstream": ""
  }
}
